{
  "name": "ai-functions-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/remove-dev-secrets.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/ai_functions_dev_registry/wrangler.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply ai-functions-dev-registry --local -c wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply ai-functions-dev-registry --remote"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
