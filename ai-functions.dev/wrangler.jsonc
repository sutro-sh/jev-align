{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-functions-dev-registry",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-functions-dev-registry",
      "database_id": "413b078f-cc20-45d9-8758-be4436b5f5ae",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "ai-functions-dev-artifacts"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://ai-functions.dev"
  }
}
